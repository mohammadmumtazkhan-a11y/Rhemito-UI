# Copy to .env (git-ignored) and fill in. Leave FURP_BASE_URL empty to use the
# public-provider/static fallback rates only.

# FURP staging affiliate rates (GET /Exchange/affiliateRates)
FURP_BASE_URL=https://furp02-staging.funtechcom.com/api/v1/mito
FURP_API_KEY=
FURP_USERNAME=
FURP_PASSWORD=
FURP_SERVICE_NO=
FURP_AFFILIATE_ID=
# FURP user the rates are requested for (sent as ?userId=); optional
FURP_USER_ID=
# FURP_TIMEOUT_MS=5000

# Mailjet transactional email (POST https://api.mailjet.com/v3.1/send)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=mohammadmumtazkhan@gmail.com
MAILJET_FROM_NAME=Rhemito
MAILJET_WEBHOOK_USER=
MAILJET_WEBHOOK_PASS=
